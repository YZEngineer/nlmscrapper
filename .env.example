SOCIALAPIS_TOKEN=

# --- fbread (browser-based Facebook scrape) ---
# 0 = gorunur Chrome (ilk giris icin), 1 = headless
PW_HEADLESS=0
PW_POST_LIMIT=25
PW_MAX_SCROLLS=60
# PW_PAGE_TIMEOUT=60000

# --- Yorum acma / scroll ayarlari ---
# Bir post'taki tum yorum-ve-yanit butonlarini acmak icin güvenlik tavani (saniye).
# 0 = sinirsiz (oenerilmez). 300 = 5 dk; buyuk thread'ler icin artirin.
#PW_COMMENT_MAX_SECONDS=300
# Kac tur "buton yok + article sabit" ise 'tam acildi' sayilir (5 = ~5 saniye tolerans)
#PW_COMMENT_SETTLE_ROUNDS=5
# Scroll islemleri arasi bekleme (saniye)
#PW_SCROLL_WAIT=3
# Grup akisi güvenlik scroll tavani (tum limitler kapaliiysa kullanilir)
#PW_FEED_MAX_SCROLLS=200
# Grup akisi 'kac tur degrad-tur' ise 'feed bitti' sayilir
#PW_FEED_STALL_ROUNDS=5